{
  "name": "iinkenngaku4-server",
  "version": "1.0.0",
  "description": "Backend server for dental clinic visit report system",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0 <=20.x.x",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:localStorage": "tsx scripts/migrate-localStorage.ts",
    "generate": "prisma generate",
    "create-user": "tsx scripts/create-initial-user.ts",
    "check-env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "bcrypt": "^6.0.0",
