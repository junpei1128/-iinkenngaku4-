# サーバー用環境変数設定ファイル
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください
# コピー方法: cp env.example .env

# ポート番号（デフォルト: 3001）
PORT=3001

# フロントエンドのURL（CORS設定用）
# フロントエンドが別のポートで起動している場合は、そのポート番号に変更してください
FRONTEND_URL=http://localhost:5185

# Gmail認証情報（メール送信機能に必要）
# Gmailアカウントのメールアドレスを設定してください
GMAIL_USER=your-email@gmail.com

# Gmailアプリパスワード（16文字、スペースなし）
# 取得方法:
# 1. Googleアカウントのセキュリティ設定にアクセス
# 2. 2段階認証を有効化
# 3. アプリパスワードを生成（「その他（カスタム名）」を選択）
# 4. 表示された16文字のパスワードをコピー（スペースを削除して設定）
GMAIL_APP_PASSWORD=your_16_character_app_password

# データベース接続URL（PostgreSQL 必須）
# 本番: Railway/Render 等が発行する接続URLをそのまま設定
# ローカル: Docker 例 → docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres
#          → postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# JWT認証用シークレットキー（ランダムな文字列を生成してください）
# 生成方法: openssl rand -base64 32 または node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_jwt_secret_key_here
