# サーバー用環境変数設定ファイル
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください
# コピー方法: cp env.example .env

# ポート番号（デフォルト: 3001）
PORT=3001

# フロントエンドのURL（CORS設定用）
# フロントエンドが別のポートで起動している場合は、そのポート番号に変更してください
FRONTEND_URL=http://localhost:5185

# Gmail認証情報（メール送信機能に必要）
# Gmailアカウントのメールアドレスを設定してください
GMAIL_USER=your-email@gmail.com

# Gmailアプリパスワード（16文字、スペースなし）
# 取得方法:
# 1. Googleアカウントのセキュリティ設定にアクセス
# 2. 2段階認証を有効化
# 3. アプリパスワードを生成（「その他（カスタム名）」を選択）
# 4. 表示された16文字のパスワードをコピー（スペースを削除して設定）
GMAIL_APP_PASSWORD=your_16_character_app_password

# データベース接続URL（SQLite）
# 開発環境: file:./dev.db
# 本番環境: PostgreSQLの場合は postgresql://user:password@host:port/database
DATABASE_URL="file:./dev.db"

# JWT認証用シークレットキー（ランダムな文字列を生成してください）
# 生成方法: openssl rand -base64 32 または node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_jwt_secret_key_here
